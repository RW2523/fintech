{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cio.local/schemas/agent_opinion/1.3",
  "title": "AgentOpinion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "opinion_id",
    "committee_run_id",
    "snapshot_id",
    "agent_id",
    "agent_version",
    "round",
    "stance",
    "confidence",
    "reason_codes",
    "claims",
    "contradictions",
    "unresolved",
    "proposed_actions",
    "tool_calls",
    "signature",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "agent_opinion/1.3"
    },
    "opinion_id": {
      "$ref": "common.1.0.json#/$defs/OpinionId"
    },
    "committee_run_id": {
      "$ref": "common.1.0.json#/$defs/RunId"
    },
    "snapshot_id": {
      "$ref": "common.1.0.json#/$defs/SnapshotId"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_version": {
      "$ref": "common.1.0.json#/$defs/AgentVersion"
    },
    "round": {
      "$ref": "common.1.0.json#/$defs/Round"
    },
    "stance": {
      "type": "string",
      "enum": [
        "SUPPORT",
        "LEAN_SUPPORT",
        "REVIEW",
        "LEAN_OPPOSE",
        "OPPOSE",
        "BLOCK",
        "NEED_MORE_EVIDENCE"
      ]
    },
    "confidence": {
      "$ref": "common.1.0.json#/$defs/Unit"
    },
    "factor_scores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "factor_score.1.0.json"
      },
      "propertyNames": {
        "enum": [
          "CAPACITY",
          "CONDUCT",
          "COMMITMENT",
          "CONDITIONS",
          "INTEGRITY"
        ]
      },
      "description": "Only the owning agent's family; must equal the tool output."
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "common.1.0.json#/$defs/ReasonCode"
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence_refs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.1.0.json#/$defs/EvidenceId"
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence_refs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common.1.0.json#/$defs/EvidenceId"
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "blocking"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 400
          },
          "blocking": {
            "type": "boolean"
          },
          "requested_evidence": {
            "type": "string"
          },
          "requested_tool": {
            "type": "string"
          }
        }
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "$ref": "action_proposal.1.0.json"
      }
    },
    "changed_from_prior": {
      "type": "string",
      "maxLength": 600,
      "description": "REVISE round only."
    },
    "tool_calls": {
      "type": "array",
      "description": "Recorded by the runtime, never written by the model.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "version",
          "call_id",
          "ok"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "call_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "signature": {
      "$ref": "common.1.0.json#/$defs/Sha256"
    },
    "created_at": {
      "$ref": "common.1.0.json#/$defs/Timestamp"
    }
  }
}
