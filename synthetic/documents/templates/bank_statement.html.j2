<!doctype html>
<html><head><meta charset="utf-8"><style>
  @page { size: A4; margin: 14mm; }
  body { font-family: 'DejaVu Sans', sans-serif; color: #14181f; font-size: 10pt; margin: 0; }
  header { display: flex; justify-content: space-between; align-items: flex-end;
           border-bottom: 2px solid #0d2a5c; padding-bottom: 8px; margin-bottom: 14px; }
  h1 { font-size: 14pt; margin: 0; color: #0d2a5c; }
  .meta { font-size: 9pt; color: #55606f; text-align: right; }
  dl { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 4px 16px;
       margin: 0 0 14px; font-size: 9.5pt; }
  dt { color: #55606f; } dd { margin: 0; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 5px 7px; font-size: 9pt; text-align: left;
           border-bottom: 1px solid #e2e6ec; }
  thead th { background: #eef2f7; color: #0d2a5c; }
  td.amount, th.amount { text-align: right; font-variant-numeric: tabular-nums; }
  td.credit { color: #14532d; }
  .closing { margin-top: 14px; text-align: right; font-size: 11pt; font-weight: 700; }
  footer { margin-top: 20px; font-size: 8pt; color: #7a8496; }
</style></head>
<body>
  <header>
    <div><h1>{{ bank_name }}</h1><div>Account statement</div></div>
    <div class="meta">Issued {{ issued_on }}<br>Page 1 of 1</div>
  </header>

  <dl>
    <dt>Account holder</dt><dd data-field="account_holder">{{ account_holder }}</dd>
    <dt>Account number</dt><dd data-field="account_number_masked">{{ account_number_masked }}</dd>
    <dt>Statement period</dt><dd data-field="period">{{ period }}</dd>
    <dt>Currency</dt><dd>{{ currency }}</dd>
  </dl>

  <table>
    <thead><tr><th>Date</th><th>Description</th>
      <th class="amount">Debit</th><th class="amount">Credit</th>
      <th class="amount">Balance</th></tr></thead>
    <tbody>
      {% for line in transactions %}
      <tr{% if line.is_salary %} data-field="salary_credit"{% endif %}>
        <td>{{ line.date }}</td><td>{{ line.description }}</td>
        <td class="amount">{{ line.debit }}</td>
        <td class="amount credit">{{ line.credit }}</td>
        <td class="amount">{{ line.balance }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="closing">Closing balance
    <span data-field="closing_balance">{{ closing_balance }}</span></div>
  <footer>Synthetic data for demonstration. Not a real bank statement.</footer>
</body></html>
