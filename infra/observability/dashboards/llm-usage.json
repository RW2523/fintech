{
  "uid": "cio-llm-usage",
  "title": "LLM usage",
  "tags": [
    "cio"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "description": "The bill and the failures. A schema-violation rate that climbs is a model or a prompt going wrong, and it costs tokens whether or not it answers.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Tokens spent, last hour",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cio-prom"
      },
      "targets": [
        {
          "expr": "sum(increase(cio_llm_tokens_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens per minute by route",
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cio-prom"
      },
      "targets": [
        {
          "expr": "sum by (route, direction) (rate(cio_llm_tokens_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{route}} {{direction}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model call p95 by route",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cio-prom"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cio_llm_request_seconds_bucket[10m])))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "unit": "s"
    },
    {
      "type": "timeseries",
      "title": "Errors by kind",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cio-prom"
      },
      "targets": [
        {
          "expr": "sum by (kind, route) (rate(cio_llm_errors_total[5m]))",
          "refId": "A",
          "legendFormat": "{{route}} {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Schema violations as a share of calls",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cio-prom"
      },
      "targets": [
        {
          "expr": "sum(rate(cio_llm_errors_total{kind=\"schema\"}[15m])) / clamp_min(sum(rate(cio_llm_request_seconds_count[15m])), 0.0001)",
          "refId": "A",
          "legendFormat": "schema failure rate"
        }
      ],
      "unit": "percentunit"
    }
  ]
}
