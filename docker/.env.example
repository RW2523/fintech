# Credit Intelligence OS — compose environment (docs/02 §5)
# Copy to docker/.env (git-ignored) and edit. Never commit real secrets.

CIO_ENV=demo
COMPOSE_PROJECT_NAME=cio
LOG_LEVEL=info

# --- host bindings ---------------------------------------------------------
# The demo binds to the Spark's LAN address. Override any port that clashes
# with something already running on the host (see scripts/env_check.sh).
BIND_ADDR=0.0.0.0
GATEWAY_PORT=8000
WEB_PORT=8080
GRAFANA_PORT=3000
TEMPORAL_UI_PORT=8233
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
OTELCOL_HEALTH_PORT=13133
LOKI_PORT=3100
TEMPO_PORT=3200
VLLM_PORT=8100
VLLM_VISION_PORT=8101
OLLAMA_PORT=11434

# --- datastores ------------------------------------------------------------
POSTGRES_USER=cio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cio
MINIO_ROOT_USER=cio
MINIO_ROOT_PASSWORD=change-me-too

# --- secrets ---------------------------------------------------------------
JWT_SECRET=change-me
TOKEN_SECRET=change-me-as-well
INTERNAL_KEY=change-me-internal

# --- LLM routing (docs/02 §4.1) -------------------------------------------
HF_TOKEN=
HF_HOME=/data/hf
LLM_AGENT_MODEL=Qwen/Qwen3-30B-A3B
LLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LLM_PROVIDER_AGENT=vllm
LLM_BASE_URL_AGENT=http://vllm:8100/v1
LLM_PROVIDER_REASONING=vllm
LLM_BASE_URL_REASONING=http://vllm:8100/v1
LLM_PROVIDER_FAST=vllm
LLM_BASE_URL_FAST=http://vllm:8100/v1
LLM_PROVIDER_VISION=vllm
LLM_BASE_URL_VISION=http://vllm_vision:8101/v1
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- GPU memory fractions of the shared 128 GB pool (docs/02 §4.3) --------
VLLM_GPU_FRACTION=0.55
VLLM_VISION_GPU_FRACTION=0.20

# --- committee budgets (docs/02 §5) ---------------------------------------
TIER1_BUDGET_SECONDS=60
TIER2_BUDGET_SECONDS=180
TIER1_TOKEN_BUDGET=60000
TIER2_TOKEN_BUDGET=150000

# --- image tags (pin validated digests here; record in docs/PROGRESS.md) ---
PG_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
TEMPORAL_IMAGE=temporalio/auto-setup:1.25.2
TEMPORAL_UI_IMAGE=temporalio/ui:2.31.2
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.115.1
PROMETHEUS_IMAGE=prom/prometheus:v3.0.1
LOKI_IMAGE=grafana/loki:3.3.2
TEMPO_IMAGE=grafana/tempo:2.6.1
GRAFANA_IMAGE=grafana/grafana:11.4.0
VLLM_IMAGE=vllm/vllm-openai:latest
